# Copy to .env (or set these as real environment variables / deploy-system
# secrets) before running `docker compose -f compose.prod.yaml up -d --build`.
# No real values belong in this file or in git.

# --- Application ---
# Generate with: php artisan key:generate --show
APP_KEY=
# Public URL the app is served at, e.g. https://example.com
APP_URL=

# --- Database ---
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Reverse proxy (lucaslorentz/caddy-docker-proxy) ---
# Comma-separated hostnames Caddy should route to this app, e.g.
# "http://app.example.com"
PROXY_HOSTS=
# Name of the pre-existing external Docker network the Caddy proxy container
# is attached to. Defaults to "caddy" if unset.
PROXY_NETWORK=

# --- Optional ---
# UID/GID the app container's PHP processes run as. Defaults to 1000/1000.
APP_UID=
APP_GID=

# --- Authentik/OIDC login (optional, additional to password login) ---
# Set AUTHENTIK_ENABLED=true plus the three vars below to turn it on; see
# backend/CLAUDE.md's "Authentik/OIDC login" section. Create an OAuth2/OIDC
# provider + application in Authentik first — the application's redirect
# URI must be {APP_URL}/auth/authentik/callback.
AUTHENTIK_ENABLED=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Authentik's own base URL, e.g. https://authentik.example.com
AUTHENTIK_BASE_URL=
# Optional override; defaults to {APP_URL}/auth/authentik/callback.
AUTHENTIK_REDIRECT_URI=
